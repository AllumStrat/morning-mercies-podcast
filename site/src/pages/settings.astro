---
import Base from "../layouts/Base.astro";
import { readFile, requestRemake, updateFile } from "../lib/github";
import { LENGTHS, PLAN_DAYS, RETENTION, VOICES, cleanSettings, loadState, parseSettings, planLabel } from "../lib/show";
import { DEMO_NOTICE, DEMO_STATE, isDemo } from "../lib/demo";

const env = Astro.locals.runtime.env;
const path = `shows/${env.SHOW}/settings.json`;
let notice = "";
let error = "";
const demo = isDemo(env);

if (Astro.request.method === "POST" && demo) return Astro.redirect("/settings?demo=1");
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const remake = form.get("action") === "remake";
  try {
    await updateFile(
      env,
      path,
      (current) => JSON.stringify(cleanSettings(form, parseSettings(current)), null, 2) + "\n",
      "Update settings",
    );
    if (!remake) return Astro.redirect("/settings?saved=1");
    try {
      await requestRemake(env);
      return Astro.redirect("/settings?remade=1");
    } catch (e) {
      console.error(e);
      return Astro.redirect("/settings?saved=1&remake_failed=1");
    }
  } catch (e) {
    console.error(e);
    error = "Those settings didn't save. Please try again in a minute.";
  }
}
if (Astro.url.searchParams.get("saved")) notice = "Saved. The next episode will use these settings.";
if (Astro.url.searchParams.get("remake_failed")) error = "Your settings saved, but the remake didn't start. Try the button again in a minute.";
if (Astro.url.searchParams.get("remade"))
  notice = "Saved, and the newest episode is being remade with this voice and speed. It replaces the old audio in your podcast app in about half an hour.";
if (Astro.url.searchParams.get("demo")) notice = DEMO_NOTICE;

const [file, state] = demo ? [null, DEMO_STATE] : await Promise.all([readFile(env, path).catch(() => null), loadState(env)]);
const settings = parseSettings(file?.text ?? null);
---
<Base title="Make it yours" eyebrow="Settings" lede="Pick the voice, pace, length and focus. The next morning's episode follows them, or remake today's right away.">
  {notice && <p class="notice">{notice}</p>}
  {error && <p class="notice error">{error}</p>}
  <form method="post" class="card">
    <label for="voice">Voice</label>
    <select id="voice" name="voice">
      {VOICES.map(([id, label]) => <option value={id} selected={id === settings.voice}>{label}</option>)}
    </select>

    <label for="voice_speed">Speaking speed: <output id="speed-out" for="voice_speed">{settings.voice_speed.toFixed(2)}x</output></label>
    <input id="voice_speed" name="voice_speed" type="range" min="0.8" max="1.3" step="0.05" value={settings.voice_speed} />

    <label for="length">Episode length</label>
    <select id="length" name="length">
      {LENGTHS.map(([id, label]) => <option value={id} selected={id === settings.length}>{label}</option>)}
    </select>

    <label for="jump_to">Reading plan day</label>
    <select id="jump_to" name="jump_to">
      <option value="">Keep going{state ? ` (next up: ${planLabel(state.next_plan_day)})` : ""}</option>
      {PLAN_DAYS.map((d) => <option value={d.id}>{d.label}</option>)}
    </select>
    <p class="hint">Pick a day to move the show there once. It carries on from that day.</p>

    <label for="focus">What should the show lean into?</label>
    <textarea id="focus" name="focus" maxlength="1000"
      placeholder="For example: more on how the Psalms apply to everyday life, fewer long quotes.">{settings.focus}</textarea>

    <label for="show_description">Show description in your podcast app</label>
    <textarea id="show_description" name="show_description" maxlength="600"
      placeholder="Leave empty to keep the current description.">{settings.show_description}</textarea>

    <label for="retention_days">Keep episodes for (days)</label>
    <input id="retention_days" name="retention_days" type="number" inputmode="numeric"
      min={RETENTION.min} max={RETENTION.max} step="1" value={settings.retention_days} />
    <p class="hint">Older episodes drop out of the feed. Between {RETENTION.min} and {RETENTION.max} days.</p>

    <button class="arrow" name="action" value="save">Save settings</button>
    <button class="arrow" name="action" value="remake">Save and remake today's episode</button>
    <p class="hint">Remaking redoes the newest episode's audio with the voice and speed above. Length, plan day and focus
      change what gets written, so they start with the next morning's episode.</p>
  </form>
</Base>

<script>
  const speed = document.getElementById("voice_speed") as HTMLInputElement | null;
  const out = document.getElementById("speed-out");
  speed?.addEventListener("input", () => { if (out) out.textContent = `${Number(speed.value).toFixed(2)}x`; });
</script>
